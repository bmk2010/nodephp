{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "NodePHP",
  "scopeName": "source.nodephp",
  "patterns": [
    { "include": "#nodePhpBlocks" },
    { "include": "#kill" },
    { "include": "#jsStatements" },
    { "include": "#variables" },
    { "include": "#functions" },
    { "include": "#builtins" },
    { "include": "text.html.basic" }
  ],
  "repository": {
    "nodePhpBlocks": {
      "begin": "<\\?nodephp",
      "end": "\\?>",
      "name": "meta.embedded.block.javascript",
      "contentName": "source.js",
      "beginCaptures": {
        "0": { "name": "keyword.control.nodephp" }
      },
      "endCaptures": {
        "0": { "name": "keyword.control.nodephp" }
      },
      "patterns": [
        { "include": "#variables" },
        { "include": "#functions" },
        { "include": "#builtins" },
        { "include": "#kill" },
        { "include": "source.js" }
      ]
    },
    "kill": {
      "match": "^\\s*\\b(kill)(?=\\s*;)",
      "captures": {
        "1": { "name": "keyword.control.nodephp" }
      }
    },
    "jsStatements": {
      "begin": "^(?=\\s*(?:\\$(?:[A-Za-z_]\\w*)\\s*=|(?:const|let|var|if|else|for|while|switch|case|default|function|class|return|throw|break|continue|new|try|catch|finally|do|typeof|delete|async|await|import|export)\\b|(?:res|req|console|process|globalThis)\\s*\\.))\\s*",
      "end": "$",
      "contentName": "source.js",
      "patterns": [
        { "include": "source.js" }
      ]
    },
    "variables": {
      "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*",
      "name": "variable.other.nodephp"
    },
    "functions": {
      "match": "\\b(file|fetch|connect|readFile|writeFile)\\s*(?=\\()",
      "name": "support.function.nodephp"
    },
    "builtins": {
      "match": "\\b(res|req|console|process|globalThis)\\s*(\\.|\\()",
      "name": "variable.language.nodephp"
    }
  }
}
