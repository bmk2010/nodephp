{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "NodePHP",
  "scopeName": "source.nodephp",
  "patterns": [
    { "include": "#nodePhpBlocks" },
    { "include": "#variables" },
    { "include": "#functions" },
    { "include": "#builtins" },
    { "include": "text.html.basic" }
  ],
  "repository": {
    "nodePhpBlocks": {
      "begin": "<\\?nodephp",
      "end": "\\?>",
      "name": "meta.embedded.block.javascript",
      "contentName": "source.js",
      "beginCaptures": {
        "0": { "name": "keyword.control.nodephp" }
      },
      "endCaptures": {
        "0": { "name": "keyword.control.nodephp" }
      },
      "patterns": [
        { "include": "#variables" },
        { "include": "#functions" },
        { "include": "#builtins" },
        { "include": "source.js" }
      ]
    },
    "variables": {
      "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*",
      "name": "variable.other.nodephp"
    },
    "functions": {
      "match": "\\b(file|fetch)\\s*(?=\\()",
      "name": "support.function.nodephp"
    },
    "builtins": {
      "match": "\\b(res|req|console|process|globalThis)\\s*(\\.|\\()",
      "name": "variable.language.nodephp"
    }
  }
}
